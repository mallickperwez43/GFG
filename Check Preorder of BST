// Recursion

class Solution {
  private:
    bool helper(vector<int> &arr, int &index, int min_val, int max_val) {
        // Base case: all elements processed
        if (index >= arr.size()) return true;

        int val = arr[index];

        // If the current element does not fit in the valid range for this subtree
        if (val < min_val || val > max_val) {
            return false;
        }

        // Move to the next element in the preorder sequence
        index++;

        // 1. Try to construct the left subtree (values must be less than current val)
        // 2. Try to construct the right subtree (values must be greater than current val)
        bool left = helper(arr, index, min_val, val);
        bool right = helper(arr, index, val, max_val);

        // Current element is valid if it can belong to either subtree or satisfies the bounds
        return left || right;
    }

  public:
    bool canRepresentBST(vector<int> &arr) {
        int index = 0;
        return helper(arr, index, INT_MIN, INT_MAX);
    }
};


// Itertive 

// User function Template for C++

class Solution {
  public:
    int canRepresentBST(int arr[], int N) {
        // code here
        stack<int> st;
        
        int root = -1;
        
        for(int i = 0; i < N; i++){
            if(arr[i] < root) { // preorder NLR
                // 2, 4, 1
                // 2 -> right -> 4 -> left -> 1 
                // voilated BST 
                return 0;
            }
            
            while(!st.empty() && arr[i] > st.top()){
                root = st.top(); // update the root for next possible iteration
                st.pop();
            }
            
            st.push(arr[i]);
        }
        
        return 1;
    }
};
