class Solution {
  public:
    int sameMod(vector<int> &arr) {
        // code here
        long long g = 0;
        
        for(int i = 1; i < arr.size(); i++) {
            g = gcd(g, llabs((long long)arr[i] - arr[0]));
        }
        
        if(g == 0)
            return -1;
        
        int count = 0;
        
        for(long long i = 1; i * i <= g; i++) {
            if(g % i == 0) {
                count++;
                
                if(i != g / i) {
                    count++;
                }
            }
        }
        
        return count;
    }
};
