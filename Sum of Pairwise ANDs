class Solution {
  public:
    typedef long long ll;
    ll pairAndSum(vector<int> &arr) {
        // code here
        ll result = 0;
        
        for(int bit = 0; bit < 32; bit++) {
            ll bitCount = 0; // count the set bit from here
            
            for(int &x : arr) {
                if(x & (1 << bit)) {
                    bitCount++;
                }
            }
            
            ll pairs = bitCount * (bitCount - 1) / 2;  // bitCount C 2 ka summation
            ll contribution = (1LL << bit);
            
            result += (pairs * contribution);
        }
        
        return result;
    }
};
