class Solution {
  public:
    int M = 1e9 + 7;
    
    int solve(int x, int y, vector<vector<int>>& dp) {
        if(x < 0 || y < 0) // invalid paths 
            return 0;
        
        if(x == 0 && y == 0) // valid path 
            return 1;
        
        if(dp[x][y] != -1)
            return dp[x][y];
        
        int left = solve(x - 1, y, dp) % M; 
        int down = solve(x, y - 1, dp) % M;
        
        return dp[x][y] = (left + down) % M;
    }
    
    int ways(int x, int y) {
        // code here
        
        vector<vector<int>> dp(x + 1, vector<int>(y + 1, -1));
        
        return solve(x, y, dp) % M;    
    }
};
