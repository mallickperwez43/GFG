class Solution {
  public:
    
    int solve(int i, int prev, vector<int>& arr, vector<vector<int>>& dp) {
        if(i == arr.size()) {
            return 0;
        }
        
        if(dp[i][prev] != -1) {
            return dp[i][prev];
        }
        
        int keep    = abs(prev - arr[i]) + solve(i + 1, arr[i], arr, dp);
        int replace = abs(prev - 1) + solve(i + 1, 1, arr, dp);
        
        return dp[i][prev] = max(keep, replace);
    }
    
    int maxDiffSum(vector<int>& arr) {
        // code here
        
        // prev can be till maxEl
        int maxEl = * max_element(arr.begin(), arr.end());
        
        vector<vector<int>> dp(arr.size() + 1, vector<int>(maxEl + 1, -1));
        
        int keepFirstEl    = solve(1, arr[0], arr, dp);
        int replaceFirstEl = solve(1, 1, arr, dp);
        
        return max(keepFirstEl , replaceFirstEl);
    }
};
