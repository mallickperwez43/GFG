class Solution {
  public:
    int beautySum(string &s) {
        // code here
        int n = s.length();
        
        int result = 0;
        
        for(int i = 0; i < n; i++) {
            vector<int> freq(26, 0);
            for(int j = i; j < n; j++) {
                freq[s[j] - 'a']++;
                
                int mx = 0;
                int mn = n + 1;
                
                for(int k = 0; k < 26; k++) {
                    if(freq[k]) {
                        mx = max(mx, freq[k]);
                        mn = min(mn, freq[k]);
                    }
                }
                
                result += (mx - mn);
            }
        }
        
        return result;
    }
};
