class Solution {
  public:
    bool isPossible(int n, int m, string& s) {
        // code here
        int minR = 0;
        int maxR = 0;
        int minC = 0;
        int maxC = 0;
        
        int r = 0;
        int c = 0;
        
        for(char& ch : s) {
            if(ch == 'L') c--;
            else if(ch == 'R') c++;
            else if(ch == 'D') r--;
            else               r++;
            
            minR = min(minR, r);
            maxR = max(maxR, r);
            minC = min(minC, c);
            maxC = max(maxC, c);
        }
        
        return (maxR - minR < n) && (maxC - minC < m);
    }
};
