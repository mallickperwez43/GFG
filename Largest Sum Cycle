class Solution {
  public:
    void cycleSum(int& sum, vector<int>& edge, int startNode) {
        sum += startNode;
        int nextNode = edge[startNode];
        
        while(nextNode != startNode) {
            sum += nextNode;
            nextNode = edge[nextNode];
        }
    }
    
    void findCycle(int u, vector<bool>& visited, vector<bool>& inRecursion, vector<int>& edge, int& cycleStart) {
        visited[u] = true;
        inRecursion[u] = true;
        
        int v = edge[u];
        
        if(v != -1) {
            if(!visited[v]) {
                findCycle(v, visited, inRecursion, edge, cycleStart);
            }
            else if(inRecursion[v]) { // cycle
                cycleStart = v;
            }
        }
        
        inRecursion[u] = false;
    }
    
    int largestSumCycle(vector<int>& edge) {
        // code here
        int n = edge.size();
        int result = -1;
        
        vector<bool> visited(n, false);
        vector<bool> inRecursion(n, false);
        
        for(int i = 0; i < n; i++) {
            if(!visited[i]) {
                int cycleStart = -1;
                findCycle(i, visited, inRecursion, edge, cycleStart);
                
                if(cycleStart != -1) {
                    int curr = 0;
                    cycleSum(curr, edge, cycleStart);
                    result = max(result, curr);
                }
            }
        }
        
        return result;
    }
};
