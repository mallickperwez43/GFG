class Solution {
  public:
    vector<bool> processQueries(vector<int> &arr, vector<vector<int>> &queries) {
        // code here
        int n = arr.size();
        
        vector<int> inc(n); // inc[i] = x-> increasing till x if start from ith index
        inc[n - 1] = n - 1;
        for(int i = n - 2; i >= 0; i--) {
            if(arr[i] <= arr[i + 1]) { //continues
                inc[i] = inc[i + 1];
            }
            else {
                inc[i] = i;
            }
        }
        
        vector<int> dec(n); // dec[i] = x-> decreasing till x if start from ith index
        dec[0] = 0;
        for(int i = 1; i < n; i++) {
            if(arr[i] <= arr[i - 1]) { //continues
                dec[i] = dec[i - 1];
            }
            else {
                dec[i] = i;
            }
        }
        
        vector<bool> result;
        for(auto& query : queries) {
            int l = query[0];
            int r = query[1];
            
            result.push_back(inc[l] >= dec[r]);
        }
        
        return result;
    }
};
