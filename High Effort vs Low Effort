class Solution {
  public:
    int n;
    
    int solve(int i, bool prevTaskDone, vector<int>& h, vector<int>& l, vector<vector<int>>& dp) {
        if(i == n) {
            return 0;
        }    
        
        if(dp[i][prevTaskDone] != -1) {
            return dp[i][prevTaskDone];
        }
        
        // do nothing
        int skip = solve(i + 1, false, h, l, dp);
        
        // do low effort task
        int low  = l[i] + solve(i + 1, true, h, l, dp);
        
        // do high effort task
        int high = 0; 
        if(!prevTaskDone) {
            high = h[i] + solve(i + 1, true, h, l, dp);
        }
        
        return dp[i][prevTaskDone] = max({skip, low, high});
    }
    
    int maxTask(vector<int>& h, vector<int>& l) {
        // code here
        n = h.size();
        
        vector<vector<int>> dp(n + 1, vector<int>(2, -1));
        
        return solve(0, false, h, l, dp);
    }
};
