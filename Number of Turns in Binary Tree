/* Structure of Binary Tree Node
class Node {
  public:
    int data;
    Node *left;
    Node *right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
}; */

class Solution {
  public:
    Node* findLCA(Node* root, int p, int q) {
        if(root == NULL) return NULL;
        
        if(root -> data == p || root -> data == q) {
            return root;
        }
        
        Node* leftLCA  = findLCA(root -> left, p, q);
        Node* rightLCA = findLCA(root -> right, p, q);
        
        if(leftLCA && rightLCA) {
            return root;
        }
        
        return leftLCA ? leftLCA : rightLCA;
    }
    
    bool findPath(Node* root, int target, string& path) {
        if(root == NULL) return false;
        if(root -> data == target) return true;
        
        // try left and explore
        path.push_back('L');
        if(findPath(root -> left, target, path)) return true;
        path.pop_back();
        
        // try right and explore
        path.push_back('R');
        if(findPath(root -> right, target, path)) return true;
        path.pop_back();
        
        return false;
    }
    
    int countTurns(string& path) {
        int n = path.length();
        int turns = 0;
        
        for(int i = 1; i < n; i++) {
            if(path[i] != path[i - 1]) {
                turns++;        
            }
        }
        
        return turns;
    }
    
    int numberOfTurns(Node* root, int p, int q) {
        // code here
        Node* lcaNode = findLCA(root, p, q);
        if(lcaNode == NULL) return -1;
        
        int turns = 0;
        
        if(lcaNode -> data == p) { // Case 1 : lca is p -> only pathQ
            string pathQ = "";
            findPath(lcaNode, q, pathQ);
            turns = countTurns(pathQ);
        }
        else if(lcaNode -> data == q) { // Case 2 : lca is q -> only pathP
            string pathP = "";
            findPath(lcaNode, p, pathP);
            turns = countTurns(pathP);
        }
        else { // Case 3 : lca is common root -> reverse(pathP) and pathQ
            string pathP = "";
            findPath(lcaNode, p, pathP);
            
            string pathQ = "";
            findPath(lcaNode, q, pathQ);
            
            // Simply reverse pathP and combine it directly with pathQ
            reverse(pathP.begin(), pathP.end());
            string fullPath = pathP + pathQ;
            
            turns = countTurns(fullPath);
        }
        
         return (turns != 0) ? turns : -1;
    }
};
