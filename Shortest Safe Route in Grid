class Solution {
  public:
    vector<vector<int>> directions = {{-1, 0}, {1, 0}, {0, 1}, {0, -1}};
    
    int shortestPath(vector<vector<int>> &mat) {
        // code here
        int n = mat.size();
        int m = mat[0].size();
        
        if(n == 0 || m == 0) {
            return -1;
        }
        
        auto inBound = [&](int i, int j) {
            return (i >= 0 && i < n && j >= 0 && j < m);
        };
        
        // S1 : Make a safe matrix
        vector<vector<int>> safeMat = mat;
        // make all ngbrs and itself as unsafe
        
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(!mat[i][j]) {
                    safeMat[i][j] = 0;
                    // mark ngbr
                    for(auto& dir : directions) {
                        int i_ = i + dir[0];
                        int j_ = j + dir[1];
                        
                        if(inBound(i_, j_)) {
                            safeMat[i_][j_] = 0;
                        }
                    }
                }
            }
        }
        
        // S2 : Multisource BFS
        queue<vector<int>> que; // {row, col, steps}
        vector<vector<bool>> visited(n, vector<bool>(m, false));
        // push safe cells for col 0 into queue
        for(int i = 0; i < n; i++) {
            if(safeMat[i][0]) {
                que.push({i, 0, 1});
                visited[i][0] = true;
            }
        }
        
        auto visitable = [&](int i, int j) {
            return (safeMat[i][j] && !visited[i][j]); 
        };
        
        // S3 : Perform BFS
        while(!que.empty()) {
            auto curr = que.front();
            que.pop();
            
            int i = curr[0];
            int j = curr[1];
            int steps = curr[2];
            
            if(j == m - 1) {
                return steps;
            }
            
            for(auto& dir : directions) {
                int i_ = i + dir[0];
                int j_ = j + dir[1];
                
                if(inBound(i_, j_) && visitable(i_, j_)) {
                    que.push({i_, j_, steps + 1});
                    visited[i_][j_] = true;
                }
            }
        }
        
        return -1;
    }
};
