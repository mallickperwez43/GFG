class Solution {
  public:
    vector<vector<int>> socialNetwork(vector<int>& arr) {
        // code here
        vector<vector<int>> ans;
        int n = arr.size() + 1;
        
        // Process every user from 2 -> n
        for(int i = 2; i <= n; i++) {
            // Allocate a distance array for the current user
            vector<int> dist(n + 1, 0);
            
            int curr = i;
            int jumps = 0;
            int next = 0;
            
            // Trace the friendship link back until user 1 is hit
            while (next != 1) {
                next = arr[curr - 2];
                jumps++;
                dist[next] = jumps;
                curr = next;
            }
            
            // Collect all valid reachable users j in strictly increasing order
            for (int j = 1; j < i; j++) {
                if (dist[j] > 0) {
                    ans.push_back({i, j, dist[j]});
                }
            }
        }
        
        return ans;
    }
};
