class Solution {
  public:
    typedef long long ll;
    
    int findMax(int n, vector<int>& a, vector<int>& b, vector<int>& k) {
        // code here
        vector<ll> diff(n + 1, 0);
        
        int m = a.size();
        
        for(int i = 0; i < m; i++) {
            int u = a[i];
            int v = b[i];
            int x = k[i];
            
            diff[u] += x;
            
            if(v + 1 < n) {
                diff[v + 1] -= x;
            }
        }
        
        ll sum = 0;
        ll result = 0;
        for(int i = 0; i < n; i++) {
            sum += diff[i];
            result = max(result, sum);
        }
        
        return result;
    }
};
