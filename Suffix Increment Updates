class Solution {
  public:
    vector<int> update(int n, vector<int>& updates) {
        // code here
        vector<int> result(n, 0);
        
        for(int& val : updates) {
            result[val - 1]++; 
        }
        
        for(int i = 1; i < n; i++) {
            result[i] += result[i - 1];
        }
        
        return result;
    }
};
