class Solution {
  public:
    typedef long long ll;
    int M = 1e9 + 7;
    int palindromicStrings(int n, int k) {
        // code here
        ll result = 0;
        
        for(int len = 1; len <= n; len++) {
            int m = len / 2; // Number of character pairs needed
            
            if(m > k) { // condition 2
                continue;
            }
            
            
            // Calculate permutations for 'm' pairs: k * (k - 1) * ... * (k - m + 1)
            ll pairWays = 1;
            for(int i = 0; i < m; i++) {
                pairWays = (pairWays * (k - i)) % M;
            }
            
            // If the length is odd, pick 1 unique character for the exact middle
            if (len & 1) {
                int remainingChoices = k - m;
                pairWays = (pairWays * remainingChoices) % M;
            }
            
            result = (result + pairWays) % M;
        }
        
        return result;
    }
}; 
