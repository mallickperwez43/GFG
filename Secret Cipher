class Solution {
  public:
    void computeLPS(int n, string& s, vector<int>& lps) {
        int len = 0; // length of previous largest prefix suffix
        lps[0] = 0; // no prefix or suffix of len [0..0]
        
        int i = 1;
        while(i < n) {
            if(s[i] == s[len]) { // matched
                len++;
                lps[i] = len;
                i++;
            }
            else { // mismatch
                if(len != 0) { // there was a prefix that matched before
                    len = lps[len - 1];
                }
                else { // no matching prev prefix so lps[i] = 0 and go ahead
                    lps[i] = 0;
                    i++;
                }
            }
        }
    }
    
    string compress(string &s) {
        // code here
        int n = s.length();
        
        if(n == 0) {
            return "";
        }
        
        // Step 1 : Compute LPS array
        vector<int> lps(n, 0);
        computeLPS(n, s, lps);
        
        // Step 2 : Right to left traversal 
        // Greedy as string as stack
        string result = "";
        int i = n - 1;
        while(i >= 0) {
            // since we are travelling right to left we need a lenth to match
            int currLen = i + 1;
            
            // Check if string can be cleanly halved using periodic pattern length
            if (currLen % 2 == 0 && lps[i] > 0) {
                int patternCycle = currLen - lps[i]; 

                // If the half-length can be built using the base pattern block
                if ((currLen / 2) % patternCycle == 0) {
                    result.push_back('*');
                    i = (currLen / 2) - 1; // Jump past second half
                    continue; 
                }
            }

            // If condition fails, process single character normally
            result.push_back(s[i]);
            i--;
        }
        
        // Step 3 : Since we calculated right to left so reverse
        reverse(result.begin(), result.end());
        
        return result;
    }
};
