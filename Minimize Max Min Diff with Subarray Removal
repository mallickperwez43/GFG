class Solution {
  public:
    int minDiff(int k, vector<int> &arr) {
        // code here
        int n = arr.size();
        
        if (k >= n) return 0;
        
        vector<int> prefMax(n), prefMin(n);
        vector<int> suffMax(n), suffMin(n);
        
        prefMax[0] = prefMin[0] = arr[0];
        for (int i = 1; i < n; i++) {
            prefMax[i] = max(prefMax[i - 1], arr[i]);
            prefMin[i] = min(prefMin[i - 1], arr[i]);
        }
        
        suffMax[n - 1] = suffMin[n - 1] = arr[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            suffMax[i] = max(suffMax[i + 1], arr[i]);
            suffMin[i] = min(suffMin[i + 1], arr[i]);
        }
        
        int minDiff = INT_MAX;
        
        int i = 0;
        int j = k - 1;
        
        while(j < n) {
            int currMax = INT_MIN;
            int currMin = INT_MAX;
            
            if(i > 0) {
                currMax = max(currMax, prefMax[i - 1]);
                currMin = min(currMin, prefMin[i - 1]);
            }
            
            if(j < n - 1) {
                currMax = max(currMax, suffMax[j + 1]);
                currMin = min(currMin, suffMin[j + 1]);
            }
            
            int currDiff = currMax - currMin;
            minDiff = min(minDiff, currDiff);
            
            i++;
            j++;
        }
        
        return minDiff;
    }
};
