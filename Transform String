class Solution {
  public:
    int transform(string &s1, string &s2) {
        // code here
        
        // Step 1 : Check Anagram
        
        int n = s1.length();
        int m = s2.length();
        
        if(n != m) {
            return -1;
        }
        
        vector<int> freq(256, 0);
        
        for(int i = 0; i < n; i++) {
            freq[s1[i] - 0]++;
            freq[s2[i] - 0]--;
        }
        
        for(int& x : freq) {
            if(x > 0) {
                return -1;
            }
        }
        
        // Step 2 : We arfe allowed to move a char ahead in s1 so itearte from back 
        int i = n - 1;
        int j = m - 1;
        int result = 0;
        
        while(i >= 0 && j >= 0) {
            if(s1[i] == s2[j]) {
                j--;
            }
            else { // mismached -> move it forward
                result++;
            }
            
            i--;
        }
        
        return result;
    }
};
 
