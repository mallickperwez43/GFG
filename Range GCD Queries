class Solution {
  public:
    int n;
    vector<int> segTree;
    
    void buildSegmentTree(int i, int l, int r, vector<int>& arr) {
        if(l == r) {
            segTree[i] = arr[l];
            return;
        }
        
        int mid = l + (r - l) / 2;
        
        buildSegmentTree(2 * i + 1, l, mid, arr);
        buildSegmentTree(2 * i + 2, mid + 1, r, arr);
        
        segTree[i] = gcd(segTree[2 * i + 1], segTree[2 * i + 2]);
    }
    
    void updateSegmentTree(int idx, int val, int i, int l, int r) {
        if(l == r) {
            segTree[i] = val;
            return;
        }
        
        int mid = l + (r - l) / 2;
        
        if(idx <= mid) {
            updateSegmentTree(idx, val, 2 * i + 1, l, mid);
        }
        else {
            updateSegmentTree(idx, val, 2 * i + 2, mid + 1, r);
        }
        
        segTree[i] = gcd(segTree[2 * i + 1], segTree[2 * i + 2]);
    }
    
    int querySegmentTree(int start, int end, int i, int l, int r) {
        if(l > end || r < start) {
            return 0;
        }
        
        if(l >= start && r <= end) {
            return segTree[i];
        }
        
        int mid = l + (r - l) / 2;
        
        int left  = querySegmentTree(start, end, 2 * i + 1, l, mid);
        int right = querySegmentTree(start, end, 2 * i + 2, mid + 1, r);
        
        return gcd(left, right);
    }
    
    vector<int> processQueries(vector<int>& arr, vector<vector<int>>& queries) {
        // code here
        n = arr.size();
        segTree.resize(4 * n);
        buildSegmentTree(0, 0, n - 1, arr);
        
        vector<int> result;
        
        for(auto& q : queries) {
            int type = q[0];
            
            if(type == 0) {
                int l = q[1];
                int r = q[2];
                
                result.push_back(querySegmentTree(l, r, 0, 0, n - 1));
            }
            else { // type = 1
                int idx = q[1];
                int val = q[2];
                updateSegmentTree(idx, val, 0, 0, n - 1);
            }
        }
        
        return result;
    }
};
