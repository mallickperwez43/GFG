class Solution {
  public:
    int M = 1e9 + 7;
    
    long long power(long long base, long long exp) {
        long long result = 1;

        while (exp > 0) {
            if (exp & 1) {
                result = (result * base) % M;
            }

            base = (base * base) % M;
            exp >>= 1;
        }

        return result;
    }

    
    int prefixStrings(int n) {
        // code here
        
        long long factN = 1;
        long long fact2N = 1;

        for (int i = 1; i <= 2 * n; i++) {
            fact2N = (fact2N * i) % M;

            if (i <= n) {
                factN = (factN * i) % M;
            }
        }

        long long inverseFactN = power(factN, M - 2);

        long long inverseNPlusOne = power(n + 1, M - 2);

        long long answer = fact2N;
        answer = (answer * inverseFactN) % M;
        answer = (answer * inverseFactN) % M;
        answer = (answer * inverseNPlusOne) % M;

        return (int)answer;
    }
};
