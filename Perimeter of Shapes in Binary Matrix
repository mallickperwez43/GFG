class Solution {
  public:
    int findPerimeter(vector<vector<int>> &mat) {
        // code here
        int n = mat.size();
        int m = mat[0].size();
        
        int perimeter = 0;
        
        for(int i = 0; i < n; i++) {
            for(int j = 0; j < m; j++) {
                if(mat[i][j] == 0) {
                    continue;
                }
                
                perimeter += 4;
                
                // up
                if(i > 0 && mat[i - 1][j]) {
                    perimeter--;
                }
                
                // down
                if(i < n - 1 && mat[i + 1][j]) {
                    perimeter--;
                }
                
                // left
                if(j > 0 && mat[i][j - 1]) {
                    perimeter--;
                }
                
                // right
                if(j < m - 1 && mat[i][j + 1]) {
                    perimeter--;
                }
            }
        }
        
        return perimeter;
    }
};
