class Solution {
  public:
    int n;
    
    int countLessEqual(int k, vector<int>& arr) {
        int sum = 0;
        int i = 0;
        int j = 0;
        int result = 0; // count of subarray whos sum in in range 0 - k
        
        while(j < n) {
            sum += arr[j];
            
            while(sum > k) {
                sum -= arr[i];
                i++;
            }
            
            result += (j - i + 1); 
            // why length [a, b, c, d, e]
            // assume [b..e] all in range
            // {b}, {b, c}, {b, c, d}, {b, c, d, e}
            // total 4 yani length
            
            j++;
        }
        
        return result;
    }
    
    int countSubarray(vector<int>& arr, int l, int r) {
        // code here
        n = arr.size();
        
        int cntSubSumExactlyR = countLessEqual(r, arr);
        int cntSubSumLMinus1  = countLessEqual(l - 1, arr);
        
        return cntSubSumExactlyR - cntSubSumLMinus1;
    }
};
