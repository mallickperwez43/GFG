class Solution {
  public:
    int countPairs(vector<int>& arr, int k) {
        // code here
        if(k == 0) return 0;
        
        sort(arr.begin(), arr.end());
        
        int i = 0;
        int j = 1;
        int n = arr.size();
        int result = 0;
        
        while(i < n) {
            if(j == i) {
                j = i + 1;
            }
            
            while(j < n && arr[j] - arr[i] < k) {
                j++;
            }
            
            result += (j - i - 1);
            
            i++;
        }
        
        return result;
    }
};
