class Solution {
public:
	int isNegativeWeightCycle(int n, vector<vector<int>>edges){
	    // Code here
	    
	    vector<int> dist(n, 0); // assume all nodes as starting point/src node
	    
	    for(int i = 0; i < n - 1; i++) {
	        for(vector<int>& edge : edges) {
	            int u  = edge[0];
	            int v  = edge[1];
	            int wt = edge[2];
	            
	            if((dist[u] + wt) < dist[v]) {
	                dist[v] = dist[u] + wt;
	            }
	        }
	    }
	    
	    int negativeCycleExist = 0;
	    
	    for(vector<int>& edge : edges) {
	        int u  = edge[0];
	        int v  = edge[1];
	        int wt = edge[2];
	        
	        if((dist[u] + wt) < dist[v]) {
                negativeCycleExist = 1;
                break;
	        }
	    }
	    
	    return negativeCycleExist;
	}
};


// Way 2

class Solution {
  public:   
    typedef long long ll;
    
    bool isNegativeWeightCycle(int V, vector<vector<int>>& edges) {
        // code here
        vector<ll> dist(V, 0);
        
        // Relax all edges V - 2 times
        for(int i = 0; i < V - 1; i++) {
            
            bool relaxed = false;
            
            for(auto& edge : edges) {
                int u = edge[0];
                int v = edge[1];
                int w = edge[2];
                
                if(dist[u] + w < dist[v]) {
				    dist[v] = dist[u] + w;
				    relaxed = true;
				}
            }
            
            if(!relaxed) {
                break;
            }
        }
        
        // Try the last Relaxation
        for(auto& edge : edges) {
            int u = edge[0];
            int v = edge[1];
            int w = edge[2];
                
            if(dist[u] + w < dist[v]) {
			    return true;
			}
        }
        
        return false;
    }
};
