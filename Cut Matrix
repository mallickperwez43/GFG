// Approach 1 - TLE

class Solution {
  public:
    
    vector<vector<int>> suffix;
    int M = 1e9 + 7;
    int dp[201][201][201];
    int m, n;
    
    
    int solve(int r, int c, int k) {
        if(k - 1 == 0) {  // k sections -> k - 1 cuts
            return (suffix[r][c] > 0) ? 1 : 0;
        }
        
        if(dp[r][c][k] != -1) {
            return dp[r][c][k];
        }
        
        long long result = 0;
        
        // horizontal cut
        for(int r_ = r + 1; r_ < m; r_++) {
            if(suffix[r_][c] == suffix[r][c]) {
                continue;
            }
            
            result = (result + solve(r_, c, k - 1)) % M;
        }
        
        // vertical cut
        for(int c_ = c + 1; c_ < n; c_++) {
            if(suffix[r][c_] == suffix[r][c]) {
                continue;
            }
            
            result = (result + solve(r, c_, k - 1)) % M;
        }
        
        return dp[r][c][k] = result;
    }
    
    int findWays(vector<vector<int>>& matrix, int k) {
        // code here
        m = matrix.size();
        n = matrix[0].size();
        
        memset(dp, -1, sizeof(dp));
        
        suffix.assign(m + 1, vector<int>(n + 1, 0));
        
        for(int i = m - 1; i >= 0; i--) {
            for(int j = n - 1; j >= 0; j--) {
                suffix[i][j] = matrix[i][j]
                            + suffix[i + 1][j]
                            + suffix[i][j + 1]
                            - suffix[i + 1][j + 1];
            }
        }
        
        return solve(0, 0, k);
    }
};

// Approach 2
// Recursion + Memoization + Binary Search -> TLE

class Solution {
  public:
    
    vector<vector<int>> suffix;
    int M = 1e9 + 7;
    int dp[201][201][201];
    int m, n;
    
    
    int solve(int r, int c, int k) {
        if(k - 1 == 0) {  // k sections -> k - 1 cuts
            return (suffix[r][c] > 0) ? 1 : 0;
        }
        
        if(dp[r][c][k] != -1) {
            return dp[r][c][k];
        }
        
        long long result = 0;
        // horizontal cut
        
        
        // for(int r_ = r + 1; r_ < m; r_++) {
        //     if(suffix[r_][c] == suffix[r][c]) {
        //         continue;
        //     } // dont check for every r_ 
        //     //  we filled suffix matrix m-1,n-1 to 0,0 and we dont want suffix to be equal
        //     // suffx[r][c] - suffrix[r_][c] > 0 so there are valid 1s while the horizontal cut
        //     // suffx[r][c] > suffrix[r_][c] 
        //     // we filled backwards so its non increasing so find first valid r_
        //     result = (result + solve(r_, c, k - 1)) % M;
        // }
        
        int l = r + 1, h = m - 1, first_valid_r = -1;
        while(l <= h) {
            int mid = l + (h - l) / 2;
            if(suffix[mid][c] < suffix[r][c]) {
                first_valid_r = mid;
                h = mid - 1; // Look for an even earlier row
            } else {
                l = mid + 1;
            }
        }
        
        if(first_valid_r != -1) {
            for(int r_ = first_valid_r; r_ < m; r_++) {
                result = (result + solve(r_, c, k - 1)) % M;
            }
        }
        
        // vertical cut
        
        // for(int c_ = c + 1; c_ < n; c_++) {
        //     if(suffix[r][c_] == suffix[r][c]) {
        //         continue;
        //     }
            
        //     result = (result + solve(r, c_, k - 1)) % M;
        // }
        
        l = c + 1;
        h = n - 1;
        int first_valid_c = -1;
        while(l <= h) {
            int mid = l + (h - l) / 2;
            if(suffix[r][mid] < suffix[r][c]) {
                first_valid_c = mid;
                h = mid - 1; // Look for an even earlier row
            } else {
                l = mid + 1;
            }
        }
        
        if(first_valid_c != -1) {
            for(int c_ = first_valid_c; c_ < n; c_++) {
                result = (result + solve(r, c_, k - 1)) % M;
            }
        }
        
        return dp[r][c][k] = result;
    }
    
    int findWays(vector<vector<int>>& matrix, int k) {
        // code here
        m = matrix.size();
        n = matrix[0].size();
        
        memset(dp, -1, sizeof(dp));
        
        suffix.assign(m + 1, vector<int>(n + 1, 0));
        
        for(int i = m - 1; i >= 0; i--) {
            for(int j = n - 1; j >= 0; j--) {
                suffix[i][j] = matrix[i][j]
                            + suffix[i + 1][j]
                            + suffix[i][j + 1]
                            - suffix[i + 1][j + 1];
            }
        }
        
        return solve(0, 0, k);
    }
};
