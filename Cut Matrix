        //         continue;
        //     }
            
        //     result = (result + solve(r, c_, k - 1)) % M;
        // }
        
        l = c + 1;
        h = n - 1;
        int first_valid_c = -1;
        while(l <= h) {
            int mid = l + (h - l) / 2;
            if(suffix[r][mid] < suffix[r][c]) {
                first_valid_c = mid;
