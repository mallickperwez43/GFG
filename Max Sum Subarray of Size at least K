// Approach 1 Using Kadane Array and Sliding Window

class Solution {
  public:
    int maxSumWithK(vector<int>& arr, int k) {
        // code here
        int n = arr.size();

        vector<int> bestEndingHere(n);

        bestEndingHere[0] = arr[0];

        for (int i = 1; i < n; i++) {
            bestEndingHere[i] = max(arr[i], bestEndingHere[i - 1] + arr[i]);
        }

        int windowSum = 0;
        int result = INT_MIN;
        for(int i = 0; i < n; i++) {
            windowSum += arr[i];
            
            if(i == k - 1) { // first k sized window
                result = windowSum;
            }
            else if(i >= k) { // sliding window (k to n - 1)
                windowSum -= arr[i - k];
                
                int currSum   = windowSum;
                int kadaneSum = currSum + bestEndingHere[i - k];
                
                result = max({result, currSum, kadaneSum});
            }
        }
        
        return result;
    }
};


// Approach 2 Using Kadane Array and Sliding Window(Space Optimised)

class Solution {
  public:
    int maxSumWithK(vector<int>& arr, int k) {
        // code here
        int n = arr.size();
        
        int windowSum = 0;  // Always holds the sum of exactly k elements
        int kadaneSum = 0;  // Tracks any extra positive elements left behind
        int result    = INT_MIN;
        
        int i = 0;
        int j = 0;
        
        while(j < n) {
            windowSum += arr[j];
            
            if(j - i + 1 > k) {
                int leftEl = arr[i];
                
                kadaneSum += leftEl; // kadane case to include it
                
                if(kadaneSum < 0) { // kadane case to start new
                    kadaneSum = 0;
                }
                
                windowSum -= leftEl;
                
                i++;
            }
            
            if(j - i + 1 == k) {
                result = max(result, windowSum + kadaneSum);
            }
            
            j++;
        }
        
        return result;
    }
};
