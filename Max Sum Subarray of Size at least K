// Approach 1 Using Kadane Array and Sliding Window

class Solution {
  public:
    int maxSumWithK(vector<int>& arr, int k) {
        // code here
        int n = arr.size();

        vector<int> bestEndingHere(n);

        bestEndingHere[0] = arr[0];

        for (int i = 1; i < n; i++) {
            bestEndingHere[i] = max(arr[i], bestEndingHere[i - 1] + arr[i]);
        }

        int windowSum = 0;
        int result = INT_MIN;
        for(int i = 0; i < n; i++) {
            windowSum += arr[i];
            
            if(i == k - 1) { // first k sized window
                result = windowSum;
            }
            else if(i >= k) { // sliding window (k to n - 1)
                windowSum -= arr[i - k];
                
                int currSum   = windowSum;
                int kadaneSum = currSum + bestEndingHere[i - k];
                
                result = max({result, currSum, kadaneSum});
            }
        }
        
        return result;
    }
};
