class Solution {
  public:
    int countFriendsPairings(int n) {
        // code here
        
        if(n <= 2) {
            return n;
        }
        
        int single = countFriendsPairings(n - 1);
        int pair   = (n - 1) * countFriendsPairings(n - 2);
        
        return single + pair;
    }
};
